    <control>
      <description>poster shadow</description>
      <type>image</type>
      <id>0</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>music_shadow.png</texture>
      <colordiffuse>ffffffff</colordiffuse>      
    </control>	  	
    <control>
      <description>Album Image Missing Art</description>
      <id>0</id>
      <type>image</type>
      <posX>1199</posX>
      <posY>220</posY>
      <width>578</width>
      <height>576</height>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered>
      <texture mask="music_mask.png">missing_coverart.png</texture>
      <zoom>yes</zoom>
    </control>
    <control>
      <description>Album art (Thumb)</description>
      <type>image</type>
      <id>0</id>
      <posX>1199</posX>
      <posY>220</posY>
      <width>578</width>
      <height>576</height>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered>
      <texture mask="music_mask.png">#AlbumInfo.Thumb</texture>      
      <zoom>yes</zoom>
      <colorkey>FFFFFFFF</colorkey>
    </control>
    <control>
      <description>Album art (Thumb)</description>
      <type>image</type>
      <id>0</id>
      <posX>1199</posX>
      <posY>220</posY>
      <width>578</width>
      <height>576</height>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered>
      <texture mask="music_mask.png">black.png</texture>      
      <zoom>yes</zoom>
      <colordiffuse>99ffffff</colordiffuse>
	  <visible>!skin.hassetting(#AlbumInfo.ShowTracks)</visible>
    </control>	
	
    
    <control Style="NoShadow">
      <description>textarea</description>
      <type>textboxscrollup</type>
      <id>0</id>
      <posX>140</posX>
      <posY>900</posY>
      <width>1670</width>
      <height>115</height>      
      <onleft>5</onleft>
      <onright>5</onright>      
      <font>font11</font>      
      <textcolor>eaeaea</textcolor>      
      <label>#AlbumInfo.Review</label>	  
    </control>
    <control Style="NoShadow">
      <description>textarea</description>
      <type>textboxscrollup</type>
      <id>0</id>
      <posX>1230</posX>
      <posY>280</posY>
      <width>540</width>
      <height>480</height>      
      <onleft>5</onleft>
      <onright>5</onright>      
      <font>font10</font>      
      <label>#AlbumInfo.Tracks</label>
      <textcolor>eaeaea</textcolor>
      <visible>!skin.hassetting(#AlbumInfo.ShowTracks)</visible>
    </control>    
  </controls>
