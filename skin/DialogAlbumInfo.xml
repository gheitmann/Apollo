<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
  <id>2001</id>
  <defaultcontrol>5</defaultcontrol>
  <allowoverlay>no</allowoverlay>
  <define>#selecteditem:</define>
  <define>#useSelectedFanart:Yes</define>
  <controls>  
    <control>
      <description>BG</description>
      <type>image</type>
      <id>1</id>
      <texture>#backgroundcolour</texture>
      <width>1920</width>
      <height>1080</height>
    </control>

    <include condition="#(eq(#Music.fanart.enable,'All Screens'))">common.music.fanart.xml</include>

    <control>
      <description>background overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>1700</posX>
      <posY>60</posY>
      <width>55</width>
      <height>55</height>
      <texture>user.png</texture>
      <colordiffuse>ffffffff</colordiffuse>
    </control>	
    <control>
      <description>background overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>1687</posX>
      <posY>47</posY>
      <width>80</width>
      <height>80</height>
      <texture>prog.png</texture>
      <animation effect="fade" time="1500" reversible="true">visible</animation>
      <animation effect="fade" time="1500" reversible="true">hidden</animation>
      <animation effect="rotate" centre="40,40" delay="0" end="-360" time="2500" loop="true" condition="true">Conditional</animation>
      <visible>player.hasmedia|topbar.visible</visible>
      <colordiffuse>ffffffff</colordiffuse>
    </control>	
     <control>
      <type>label</type>
      <id>1</id>
      <posX>1680</posX>
      <posY>70</posY>
      <width>200</width>
      <height>30</height>
      <label>#media.user</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
      <visible>[!player.hasaudio]+string.isset(#media.user)</visible>
    </control>

    <control>
      <type>label</type>
      <id>1</id>
      <posX>1680</posX>
      <posY>70</posY>
      <width>200</width>
      <height>30</height>
      <label>Playing audio..</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
      <visible>player.hasaudio</visible>
    </control>	   
	
    <control>
      <description>Current window</description>
      <type>label</type>
      <id>0</id>
      <posX>135</posX>
      <posY>48</posY>
      <align>left</align>
      <width>1800</width>
      <font>font18</font>		  
      <label>#(iif(and(neq(L(102012), #currentmodule), neq(L(102002), #currentmodule), neq(L(100100), #currentmodule), neq(L(102015), #currentmodule)), #currentmodule, ' '))</label>
      <textcolor>eaeaea</textcolor>		  
      <animation effect="fade" time="250">WindowOpen</animation>
      <animation effect="fade" time="250">WindowClose</animation>
    </control>

    <control>
      <description>Album Title</description>
      <type>label</type>
      <id>0</id>
      <posX>135</posX>
      <posY>95</posY>
      <label>#AlbumInfo.Title</label>
      <align>left</align>
      <font>font10</font>
      <textcolor>eaeaea</textcolor>
      <animation effect="fade" time="250">WindowOpen</animation>
      <animation effect="fade" time="250">WindowClose</animation>
    </control>

    <control>
      <description>group element</description>
      <type>group</type>
      <layout>StackLayout(2, Vertical, true)</layout>
      <posX>130</posX>
      <posY>700</posY>
      <control>
        <description>Tracks/Review</description>
        <type>button</type>
        <id>5</id>
        <width>1050</width>
	    <height>50</height>
        <label>#(L(183)) /#(L(182))</label>
        <textcolor>ffffffff</textcolor>
        <colordiffuse>ffffffff</colordiffuse>
        <textureFocus>btn_list.png</textureFocus>
        <font>font11</font>
        <onleft>5</onleft>
        <onright>6</onright>
        <onup>17</onup>
        <ondown>5</ondown>
        <onclick>#(skin.togglesetting('#AlbumInfo.ShowTracks'))</onclick> 
      </control>
      <control>
        <description>Refresh</description>
        <type>button</type>
        <id>6</id>
        <width>1050</width>
	    <height>50</height>
        <label>184</label>
        <textcolor>ffffffff</textcolor>
        <colordiffuse>ffffffff</colordiffuse>
        <textureFocus>btn_list.png</textureFocus>
        <font>font11</font>
        <onleft>5</onleft>
        <onright>5</onright>
        <onup>17</onup>
        <ondown>6</ondown>
      </control>      
    </control>    

	
    <control>
      <description>group element</description>
      <type>group</type>
      <layout>StackLayout(45, Vertical, true)</layout>
      <posX>140</posX>
      <posY>230</posY>
    <control Style="NoShadow">
      <description>Artist</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>260</posY>      
      <label>Artist: #AlbumInfo.Artist</label>
      <font>font11</font>
      <width>300</width>      
      <textcolor>white</textcolor>
    </control>	

    <control Style="NoShadow">
      <description>Date of Release</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>340</posY>
      <label>Year: #AlbumInfo.Year</label>
      <font>font11</font>
      <width>300</width>      
      <textcolor>white</textcolor>
    </control>

    <control Style="NoShadow">
      <description>Rating</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>420</posY>
      <label>Rated: #AlbumInfo.Rating/10</label>
      <font>font11</font>
      <width>300</width>      
      <textcolor>white</textcolor>
    </control>

    <control Style="NoShadow">
      <description>Genre</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>500</posY>
      <label>Genre:</label>
      <font>font11</font>
      <width>300</width>      
      <textcolor>white</textcolor>
    </control>
    <control Style="NoShadow">
      <description>Genre value</description>
      <type>textbox</type>
      <id>0</id>
      <posX>140</posX>
      <posY>540</posY>
      <label>#AlbumInfo.Genre</label>
      <font>font11</font>
	  <height>80</height>
      <width>1000</width>
      <textcolor>eaeaea</textcolor>
    </control>
    <control Style="NoShadow">
      <description>Tones</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>580</posY>	  
      <label>Tones:</label>
      <font>font11</font>
      <width>300</width>      
      <textcolor>white</textcolor>
    </control>
    <control Style="NoShadow">
      <description>Tones value</description>
      <type>textbox</type>
      <id>0</id>
      <posX>140</posX>
      <posY>620</posY>      
      <label>#AlbumInfo.Tones</label>
      <font>font11</font>
	  <height>80</height>
      <width>1000</width>
      <textcolor>eaeaea</textcolor>
    </control>
    </control>
