    <control>
      <description>poster shadow</description>
      <type>image</type>
      <id>0</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>music_shadow.png</texture>
      <colordiffuse>ffffffff</colordiffuse>      
    </control>	  
    <control>
      <description>Artist Image Missing Art</description>
      <id>0</id>
      <type>image</type>
      <posX>1199</posX>
      <posY>220</posY>
      <width>578</width>
      <height>576</height>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered>   	  
      <texture mask="music_mask.png">missing_Coverart.png</texture>
      <zoom>yes</zoom>
    </control>	
    <control>
      <description>Artist Image</description>
      <type>image</type>
      <id>0</id>
      <posX>1199</posX>
      <posY>220</posY>
      <width>578</width>
      <height>576</height>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered> 
      <texture mask="music_mask.png">#ArtistInfo.Thumb</texture>
      <zoom>yes</zoom>
      <colorkey>FFFFFFFF</colorkey>
    </control>    
    <control>
      <description>Album art (Thumb)</description>
      <type>image</type>
      <id>0</id>
