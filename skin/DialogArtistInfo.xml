    <control Style="NoShadow">
      <description>textarea</description>
      <type>textboxscrollup</type>
      <id>0</id>
      <posX>140</posX>
      <posY>900</posY>
      <width>1670</width>
      <height>115</height> 
      <onleft>5</onleft>
      <onright>5</onright>      
