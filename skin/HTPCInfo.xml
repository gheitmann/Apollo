	  <width>1800</width>
	  <font>font18</font>
      <label>#(L(350038))</label>
      <textcolor>eaeaea</textcolor>
      <visible>!player.hasmedia</visible>	
    </control>
	
		<control>
		  <description>Date / Time</description>
