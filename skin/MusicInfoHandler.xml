<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
<id>1599</id>
<defaultcontrol>50</defaultcontrol>
<allowoverlay>yes</allowoverlay>
<define>#header.label:2</define>
<define>#useSelectedFanart:Yes</define>
<controls>
    <control>
      <description>BG</description>
      <type>image</type>
      <id>1</id>
      <texture>#backgroundcolour</texture>
      <width>1920</width>
      <height>1080</height>
    </control>
    
   <control>
      <description>background overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>1700</posX>
      <posY>60</posY>
      <width>55</width>
      <height>55</height>
      <texture>user.png</texture>
      <colordiffuse>ffffffff</colordiffuse>
    </control>	
    <control>
      <description>background overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>1687</posX>
      <posY>47</posY>
      <width>80</width>
      <height>80</height>
      <texture>prog.png</texture>
      <animation effect="fade" time="1500" reversible="true">visible</animation>
      <animation effect="fade" time="1500" reversible="true">hidden</animation>
      <animation effect="rotate" centre="40,40" delay="0" end="-360" time="2500" loop="true" condition="true">Conditional</animation>
      <visible>player.hasmedia|topbar.visible+!control.isvisible(08701)</visible>
      <colordiffuse>ffffffff</colordiffuse>
	  
    
	
    </control>	
     <control>
      <type>label</type>
      <id>1</id>
      <posX>1680</posX>
      <posY>70</posY>
      <width>200</width>
      <height>30</height>
      <label>#media.user</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
      <visible>[!player.hasaudio]+string.isset(#media.user)</visible>
    </control>	
    <control>
      <type>label</type>
      <id>1</id>
      <posX>1680</posX>
      <posY>70</posY>
      <width>200</width>
      <height>30</height>
      <label>Playing audio..</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
      <visible>player.hasaudio</visible>
    </control>	  
	
    <control>
      <description>Current window</description>
      <type>label</type>
      <id>0</id>
      <posX>135</posX>
      <posY>48</posY>
      <align>left</align>
      <width>1800</width>
      <font>font18</font>		  
      <label>MusicInfo Handler</label>
      <textcolor>eaeaea</textcolor>		  
      <animation effect="fade" time="250">WindowOpen</animation>
      <animation effect="fade" time="250">WindowClose</animation>
    </control>
		
    <control>
      <description>Date / Time</description>
      <type>label</type>
      <id>0</id>
      <posX>135</posX>
      <posY>95</posY>
      <label>#time</label>
      <align>left</align>
      <font>font10</font>
      <textcolor>eaeaea</textcolor>
      <animation effect="fade" time="250">WindowOpen</animation>
      <animation effect="fade" time="250">WindowClose</animation>
    </control>	  
	  
	<!--            :: LISTVIEW ::            -->
	
      <control>
        <description>poster shadow</description>
        <type>image</type>
        <id>0</id>
        <posX>0</posX>
        <posY>0</posY>
        <width>1920</width>
        <height>1080</height>
        <texture>music_shadow.png</texture>
        <colordiffuse>ffffffff</colordiffuse>
	    <animation effect="fade" time="350" reversible="true">hidden</animation>
      </control>	

	<control>
		<id>0</id>
		<type>image</type>
		<posX>1199</posX>
        <posY>220</posY>
        <width>578</width>
        <height>576</height>
		<visible>[facadeview.list | facadeview.album]+!control.hasthumb(500)+!string.contains(#selecteditem, ..)</visible>
		<texture mask="music_mask.png">defaultAudioBig.png</texture>
 		<animation effect="fade" time="250">WindowOpen</animation>
		<animation effect="fade" time="250">WindowClose</animation>
	</control>
	
	<control>
		<id>0</id>
		<type>image</type>
		<posX>1199</posX>
        <posY>220</posY>
        <width>578</width>
        <height>576</height>
		<texture mask="music_mask.png">DefaultFolderBackBig.png</texture>
		<visible>[facadeview.list | facadeview.album]+string.contains(#selecteditem, ..)]</visible>
  		<animation effect="fade" time="250">WindowOpen</animation>
		<animation effect="fade" time="250">WindowClose</animation>
	</control>
	
	<control>
		<description>Cover Art</description>
		<type>image</type>
		<id>500</id>
		<posX>1199</posX>
        <posY>220</posY>
        <width>578</width>
        <height>576</height>
		<texture mask="music_mask.png">#selectedthumb</texture>
		<visible>[facadeview.list | facadeview.album]+Control.IsVisible(50)</visible>
  		<animation effect="fade" time="250">WindowOpen</animation>
		<animation effect="fade" time="250">WindowClose</animation>
	</control>
    
<import>common.facade.music.xml</import>

	<!-- Gradient overlay -->
	  <control>
        <type>image</type>
        <id>0</id>
	<posX>0</posX>
	<posY>735</posY>
        <width>1920</width>
        <height>164</height>
        <texture>#overlaycolour</texture>
        <visible>[facadeview.largeicons|facadeview.smallicons]</visible>
      </control>
      <!-- Gradient overlay -->  
	  
<!-- Apollo uses the native media overlays; the old common.overlay.xml was not supplied. -->
	
</controls>
</window>
				