    <!--  **********  Button Group **********  -->      
	  
    <control>
      <description>group element</description>
      <type>group</type>
      <layout>StackLayout(3, Horizontal, true)</layout>
      <posX>140</posX>
      <posY>200</posY>
      <control>
        <description>Biography Button</description>
        <type>checkbutton</type>
        <id>3</id>
        <width>300</width>
	<height>40</height>
        <label>1011</label>
        <textcolor>ffffffff</textcolor>
        <colordiffuse>ffffffff</colordiffuse>
        <font>font11</font>
        <onleft>3</onleft>
        <onright>4</onright>
        <onup>21</onup>
        <ondown>24</ondown>
      </control>
      <control>
        <description>Movies Button</description>
        <type>checkbutton</type>
        <id>4</id>
        <width>300</width>
	<height>40</height>
        <label>342</label>
        <textcolor>ffffffff</textcolor>
        <colordiffuse>ffffffff</colordiffuse>
        <font>font11</font>
        <onleft>3</onleft>
        <onright>4755</onright>
        <onup>21</onup>
        <ondown>24</ondown>
      </control>
      <control>
        <description>IMDb Trailer Button (Online Videos)</description>
        <type>button</type>
        <id>4755</id>
        <width>300</width>
	<height>40</height>
        <label>IMDb Trailers</label>
        <font>font11</font>
        <hyperlink>4755</hyperlink>
        <hyperlinkParameter>site:IMDb Movie Trailers|search:#(iif(neq(#imdbnumber,''),#imdbnumber,#title))|return:Locked</hyperlinkParameter>
        <onup>21</onup>
        <ondown>24</ondown>
        <onleft>4</onleft>
        <onright>3</onright>
        <visible>plugin.isenabled(OnlineVideos)+control.isvisible(24)</visible>
      </control>
    </control>
    <!--  **********  Actor Biography **********  -->
    <control Style="NoShadow">
