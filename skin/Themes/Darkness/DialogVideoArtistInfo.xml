      <unfocusedAlpha>180</unfocusedAlpha>
      <font>font11</font>
      <textcolor>ffffffff</textcolor>
      <textcolorNoFocus>ff888888</textcolorNoFocus>
      <textvisible2>no</textvisible2>
      <textvisible3>no</textvisible3>
