<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
  <controls>
		
	<control>
      <description>Fanart Background #1</description>
      <type>image</type>
      <id>524</id>
      <posX>0</posX>
      <posY>50</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>#TVSeries.Fanart.1</texture>
	  <colordiffuse>75ffffff</colordiffuse>
	  <visible>facadeview.list+control.isvisible(1232)</visible>
      <animation effect="fade" time="100">visible</animation>
      <animation effect="fade" time="100" delay="50">hidden</animation>
	  <animation effect="zoom" start="100,100" end="110,110" time="45000" delay="5000" pulse="false" condition="control.isvisible(524)">conditional</animation>
	  <animation effect="slide" end="70,70" time="45000" delay="5000" pulse="false" condition="control.isvisible(524)">conditional</animation>
    </control>
    <control>
      <description>Fanart Background #2</description>
      <type>image</type>
      <id>525</id>
      <posX>0</posX>
      <posY>50</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>#TVSeries.Fanart.2</texture>
	  <colordiffuse>75ffffff</colordiffuse>
	  <visible>facadeview.list+control.isvisible(1232)</visible>
      <animation effect="fade" time="100">visible</animation>
      <animation effect="fade" time="100" delay="50">hidden</animation>
	  <animation effect="zoom" start="100,100" end="110,110" time="45000" delay="5000" pulse="false" condition="control.isvisible(525)">conditional</animation>
	  <animation effect="slide" end="70,70" time="45000" delay="5000" pulse="false" condition="control.isvisible(525)">conditional</animation>	  
    </control>	
		
	    <!-- Gradient overlay -->
	  <control>
        <type>image</type>
        <id>0</id>
		<posX>-5</posX>
		<posY>0</posY>
        <width>1925</width>
        <height>1080</height>
        <texture>#fanartoverlaycolour</texture>
		<visible>facadeview.list+control.isvisible(1232)</visible>
      </control>
	<!-- Gradient overlay -->  	
	
	
	<!--#overlayfanart-->
	

  </controls>
</window>
