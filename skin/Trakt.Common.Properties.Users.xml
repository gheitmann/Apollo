      <posY>940</posY>
      <width>1550</width>
      <height>80</height>
      <label>#Trakt.User.About</label>
      <font>font11</font>
      <textcolor>ffffffff</textcolor>
      <visible>facadeview.list+!string.equals(#Trakt.User.About,)+!string.equals(#Trakt.User.About,--)</visible>
    </control>

	

  </controls>
