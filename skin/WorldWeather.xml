	<control>
      <description>background overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>1700</posX>
      <posY>60</posY>
      <width>55</width>
      <height>55</height>
      <texture>user.png</texture>
      <colordiffuse>ffffffff</colordiffuse>
    </control>
	
    <control>
      <description>background overlay</description>
      <type>image</type>
      <id>12000</id>
      <posX>1687</posX>
      <posY>47</posY>
      <width>80</width>
      <height>80</height>
      <texture>prog.png</texture>
	  <animation effect="fade" time="1500" reversible="true">visible</animation>
	  <animation effect="fade" time="1500" reversible="true">hidden</animation>
	  <animation effect="rotate" centre="40,40" delay="0" end="-360" time="2500" loop="true" condition="true">Conditional</animation>
	  <visible>player.hasmedia|topbar.visible+!control.isvisible(08701)</visible>
      <colordiffuse>ffffffff</colordiffuse>
    </control>
	
    
	
	<control>
      <type>label</type>
      <id>1</id>
      <posX>1680</posX>
      <posY>70</posY>
      <width>300</width>
      <height>30</height>
      <label>#media.user</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
    <visible>string.isset(#media.user)</visible>
</control>

	<control>
	  <description>Current Category</description>
      <type>label</type>
      <id>0</id>
      <posX>138</posX>
      <posY>48</posY>
      <align>left</align>
      <width>1800</width>
      <font>font18</font>		  
	  <label>717</label>
	  <textcolor>eaeaea</textcolor>		  
	  <animation effect="fade" time="250">WindowOpen</animation>
	  <animation effect="fade" time="250">WindowClose</animation>
	  <visible>!player.hasmedia+!player.hasaudio</visible>
	</control> 

	<control>
	  <description>Date / Time</description>
	  <type>label</type>
      <id>0</id>
	  <posX>138</posX>
	  <posY>95</posY>
	  <label>#time #WorldWeather.Location</label>
	  <align>left</align>
	  <font>font10</font>
	  <textcolor>eaeaea</textcolor>
	  <animation effect="fade" time="250">WindowOpen</animation>
      <animation effect="fade" time="250">WindowClose</animation>
	  <visible>!player.hasmedia+!player.hasaudio</visible>
	</control>		
	
