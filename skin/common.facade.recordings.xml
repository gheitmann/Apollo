<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
  <controls>
    <control>
      <description>group element</description>
      <type>group</type>
      <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
      <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
      <control>
        <description>composite control consisting of a list control and a thumbnail panel</description>
        <type>facadeview</type>
        <id>50</id>
        <control>
          <description>listcontrol</description>
          <type>listcontrol</type>
          <id>50</id>
		  <posX>115</posX>
		  <posY>230</posY>
          <height>620</height>
		  <width>980</width>
          <font>font11</font>
          <font2>font11</font2>
		  <textYOff>7</textYOff>
		  <textYOff2>7</textYOff2>
		  <textXOff>-15</textXOff>
		  <textXOff2>970</textXOff2>
		  <spaceBetweenItems>2</spaceBetweenItems>
		  <PinIconXOff>970</PinIconXOff>
          <PinIconYOff>3</PinIconYOff>
          <PinIconWidth>72</PinIconWidth>
          <PinIconHeight>72</PinIconHeight>
		  <textureNoFocus></textureNoFocus>
          <textureFocus>btn_list.png</textureFocus>
		  <IconXOff>-1800</IconXOff>
        </control>
        <control>
          <description>album view listcontrol</description>
          <type>listcontrol</type>
          <subtype>album</subtype>
          <id>50</id>
          <posX>115</posX>
          <posY>230</posY>
          <width>980</width>
          <height>630</height>
          <font>font11</font>
          <font2>font11</font2>
		  <font3>font11</font3>
          <selectedColor>ff666666</selectedColor>
          <textcolor>ffffffff</textcolor>
		  <textureFocus>btn_list.png</textureFocus>
          <textcolorNoFocus>ff888888</textcolorNoFocus>      
          <selectedColor2>ff009900</selectedColor2>
          <textcolor2>ff666666</textcolor2>
          <textXOff>-55</textXOff>
		  <textXOff3>3000</textXOff3>
		  <textYOff3>7</textYOff3>
          <textYOff>7</textYOff>
		  <PinIconXOff>970</PinIconXOff>
          <PinIconYOff>3</PinIconYOff>
          <PinIconWidth>72</PinIconWidth>
          <PinIconHeight>72</PinIconHeight>
          <textXOff2>970</textXOff2>
          <textYOff2>7</textYOff2>
          <itemWidth>72</itemWidth>
          <itemHeight>72</itemHeight>
          <IconXOff>3000</IconXOff>
          <IconYOff>5</IconYOff>
          <spaceBetweenItems>0</spaceBetweenItems>
          <textureHeight>50</textureHeight>
          <scrollOffset>1</scrollOffset>
          <onleft>2</onleft>
          <onright>50</onright>
          <onup>2</onup>
          <ondown>2</ondown>
        </control>
        <control>
          <description>Thumbnail Panel</description>
          <type>thumbnailpanel</type>
          <dimColor>90ffffff</dimColor>
          <id>50</id>
          <posX>135</posX>
          <posY>215</posY>
          <width>850</width>
          <height>720</height>
          <scrollOffset>1</scrollOffset>
          <onleft>2</onleft>
          <onright>2</onright>
					<!-- Small Icons 0.66 aspect ratio -->
					<itemWidth>150</itemWidth>
				    <itemHeight>107</itemHeight>
				    <textureWidth>145</textureWidth>
				    <textureHeight>100</textureHeight>
				    <thumbWidth>145</thumbWidth>
				    <thumbHeight>100</thumbHeight>
				    <thumbPosX>0</thumbPosX>
				    <thumbPosY>0</thumbPosY>				
					<!-- Large Icons 0.66 aspect ratio -->
					<textureWidthBig>250</textureWidthBig>
					<textureHeightBig>160</textureHeightBig>
					<itemWidthBig>250</itemWidthBig>
					<itemHeightBig>163</itemHeightBig>
					<thumbWidthBig>250</thumbWidthBig>
					<thumbHeightBig>160</thumbHeightBig>
					<thumbPosXBig>0</thumbPosXBig>
					<thumbPosYBig>0</thumbPosYBig>
          <thumbPosXBig>0</thumbPosXBig>
          <thumbPosYBig>0</thumbPosYBig>
          <thumbPosX>0</thumbPosX>
          <thumbPosY>0</thumbPosY>
          <thumbZoom>no</thumbZoom>
          <enableFocusZoom>no</enableFocusZoom>
          <zoomXPixels>10</zoomXPixels>
          <zoomYPixels>10</zoomYPixels>
          <hideUnfocusTexture>yes</hideUnfocusTexture>
          <renderFocusText>no</renderFocusText>
          <renderUnfocusText>no</renderUnfocusText>
          <showFrame>true</showFrame>
          <imageFolder>-</imageFolder>
          <imageFolderFocus>-</imageFolderFocus>
          <textureMask>Picturethumbmask.png</textureMask>
          <frameNoFocus>shadframe.png</frameNoFocus>
          <frameFocus>shadframe.png</frameFocus>
          <keepaspectratio>no</keepaspectratio>
          <font>font10</font>
          <spinCanFocus>no</spinCanFocus>
          <dimColor>80ffffff</dimColor>
          <spinPosY>1012</spinPosY>
        </control>
      </control>
    </control>
  </controls>
</window>
