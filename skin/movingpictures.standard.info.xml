<window>
  <controls>
 
	<!-- Listview info -->
	
    <control>
      <description>summery</description>
      <type>textboxscrollup</type>
      <id>0</id>
	  <textalign>left</textalign>
      <posX>280</posX>
      <posY>900</posY>
      <width>1530</width>
      <height>115</height>
      <textcolor>eaeaea</textcolor>
      <font>font11</font>
      <label>#MovingPictures.SelectedMovie.summary</label>
      <visible>[facadeview.list|control.isvisible(6)]+!control.isvisible(51)</visible>
    </control>	
	
	<!-- Thumbsview info -->
  
    <control Style="NoShadow">
      <description>Movie Title</description>
      <type>label</type>
      <id>0</id>
      <width>1550</width>
