      <posY>900</posY>
      <align>left</align>
      <font>font11</font>
      <label>#MovingPictures.SelectedMovie.title</label>
      <textcolor>eaeaea</textcolor>
      <visible>[facadeview.smallicons|facadeview.largeicons|facadeview.filmstrip|facadeview.coverflow]+!control.isvisible(6)</visible>
      <animation effect="fade" time="250" delay="0">WindowClose</animation>
    </control>
	
	<control>
      <description>summery</description>
