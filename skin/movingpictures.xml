<?xml version="1.0" encoding="utf-8"?>
<!--
This file should contain the facade view and all gui
elements that should remain on screen during all or
multiple view modes.
-->
<window>
	<id>96742</id>
	<defaultcontrol>50</defaultcontrol>
	<allowoverlay>no</allowoverlay>

	<!--
	This set of defines are read by the plug-in and used to determine aspects of it's behavior. These
	are parameters to give the skinner a tiny bit more control over the presentation.
	-->
	<define>#largeicons.available:true</define>      		<!-- true if this skin implements the largeicons view -->
	<define>#largeicons.backdrop.used:true</define> 		<!-- true if backdrop (fanart) should be displayed in this view -->

	<define>#smallicons.available:true</define>      		<!-- Set to true if this skin implements the smallicons view -->
	<define>#smallicons.backdrop.used:true</define> 		<!-- true if backdrop (fanart) should be displayed in this view -->

	<define>#list.available:true</define>            		<!-- Set to true if this skin implements the list view -->
	<define>#list.backdrop.used:true</define>        		<!-- true if backdrop (fanart) should be displayed in this view -->

	<define>#filmstrip.available:true</define>       		<!-- Set to true if this skin implements the filmstrip view -->
	<define>#filmstrip.backdrop.used:true</define>   		<!-- true if backdrop (fanart) should be displayed in this view -->

	<define>#coverflow.available:true</define>       		<!-- Set to true if this skin implements the coverflow view -->
	<define>#coverflow.backdrop.used:true</define>   		<!-- true if backdrop (fanart) should be displayed in this view -->

	<define>#categories.backdrop.used:false</define>     <!-- true if backdrop (fanart) should be displayed in this view -->
	<define>#details.backdrop.used:true</define>   	    <!-- true if backdrop (fanart) should be displayed in this view -->

	<!-- Change the values below to adjust the delay  in (seconds) that text scrolls in movie overviews -->
	<define>#textboxscrolldelay.list:12</define>
	<define>#textboxscrolldelay.thumbs:12</define>
	<define>#textboxscrolldelay.filmstrip:16</define>
	<define>#textboxscrolldelay.details:16</define>
	
	<!-- Shadows under blue/grey text -->
  <define>#shadow.dark:ff111111</define>						
  <!-- Shadows under white text -->
  <define>#shadow.light:ff222222</define>
  
		
	<controls>

		<!--            :: DUMMY CONTROLS ::             -->

		<control>
		  <description>Visibile when filtering by watched flag. Only unwatched movies are listed.</description>
		  <type>label</type>
		  <id>8</id>
		  <posX>-75</posX>
		  <posY>-75</posY>
		  <width>0</width>
		</control>

		<control>
		  <description>Visibile when the currently selected movie has been watched</description>
		  <type>label</type>
		  <id>9</id>
		  <posX>-75</posX>
		  <posY>-75</posY>
		  <width>0</width>
		</control>

		<control>
		  <description>Visibile when filtering by remote control searching.</description>
		  <type>label</type>
		  <id>10</id>
		  <posX>-75</posX>
		  <posY>-75</posY>
		  <width>0</width>
		</control>
		
		<control>
		  <description>Visibile when movies are filtered.</description>
		  <type>image</type>
		  <id>17</id>
		  <posX>-75</posX>
		  <posY>-75</posY>
		  <width>0</width>
		</control>
		
		<control>
		  <description>Visibile when movie playback has started</description>
		  <type>image</type>
		  <id>18</id>
		  <posX>-75</posX>
		  <posY>-75</posY>
		  <width>0</width>
		</control>
		
		<!--            :: BACKGROUNDS :: MOVIE BACKDROP :: OVERLAYS ::            -->

		<control>
		  <description>Default Background</description>
		  <type>image</type>
		  <id>0</id>
		  <posX>0</posX>
		  <posY>0</posY>
		  <width>1920</width>
		  <height>1080</height>
		  <texture>#backgroundcolour</texture>
		</control>
		<control>
		  <description>Default Background</description>
		  <type>image</type>
		  <id>0</id>
		  <posX>0</posX>
		  <posY>0</posY>
		  <width>1920</width>
		  <height>1080</height>
		  <texture>fan#backgroundcolour</texture>
		  <visible>string.equals(#MovingPictures.fanart.enable,Yes)</visible>
		</control>		

		
		<control>
		  <description>Movie Backdrop (Fan Art) - Plug-in sets to invisible, if no art.</description>
		  <type>image</type>
		  <id>1</id>
		  <posX>0</posX>
		  <posY>0</posY>
		  <height>1080</height>
		  <width>1920</width>
		  <texture>#MovingPictures.Backdrop</texture>
		  <colordiffuse>00ffffff</colordiffuse>
		  <animation effect="fade" delay="0" reversible="false" time="200" >visiblechange</animation>
		  <!--Do not modify the visibility for this component. It is handled by the plug-in. Use the above 
			   defines for conditional visibility if you dont want to use fan-art only specific views. -->
		</control>

		<control>
		  <description>Alternate Movie Backdrop - Toggles Load with Component 1 for animations on visibiltiy</description>
		  <type>image</type>
		  <id>11</id>
		  <posX>0</posX>
		  <posY>0</posY>
		  <height>1080</height>
		  <width>1920</width>
		  <texture>#MovingPictures.Backdrop2</texture>
		  <colordiffuse>00ffffff</colordiffuse>
		  <animation effect="fade" delay="0" reversible="false" time="200" >visiblechange</animation>
		  <!-- Do not modify the visibility for this component. It is handled by the plug-in. Use the above 
			   defines for conditional visibility if you dont want to use fan-art only specific views. -->
		</control>
		

		
		<!-- VIEWS -->

		<import>movingpictures.categories.xml</import>
		
		<include condition="#(eq(#MovingPictures.fanart.enable,'No'))">movingpictures.facade.xml</include>
		<include condition="#(eq(#MovingPictures.fanart.enable,'Yes'))">movingpictures.facade.fanart.xml</include>
		
		<include condition="#(eq(#MovingPictures.fanart.enable,'No'))">movingpictures.mediainfo.xml</include>
		<include condition="#(eq(#MovingPictures.fanart.enable,'Yes'))">movingpictures.mediainfo.fanart.xml</include>
		
		<include condition="#(eq(#MovingPictures.fanart.enable,'No'))">movingpictures.thumbsview.xml</include>
		<include condition="#(eq(#MovingPictures.fanart.enable,'Yes'))">movingpictures.thumbsview.fanart.xml</include>
		
		<include condition="#(eq(#MovingPictures.fanart.enable,'No'))">movingpictures.listview.xml</include>
		<include condition="#(eq(#MovingPictures.fanart.enable,'Yes'))">movingpictures.listview.fanart.xml</include>
		
		<!--
		<import>movingpictures.filmstripview.xml</import>
		<import>movingpictures.coverflowview.xml</import>
		-->
			
		<include condition="#(eq(#skin.movpic.extra,'yes'))">movingpictures.extra.info.xml</include>
		<include condition="#(eq(#skin.movpic.extra,'no'))">movingpictures.standard.info.xml</include>
		
		<include condition="#(eq(#MovingPictures.fanart.enable,'No'))">movingpictures.details.xml</include>
		<include condition="#(eq(#MovingPictures.fanart.enable,'Yes'))">movingpictures.details.fanart.xml</include>
		<import>movingpictures.hiddenmenu.xml</import>
		
	<!--Now recording info on home-->


	<control>
      <description>background overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>1700</posX>
      <posY>60</posY>
      <width>55</width>
      <height>55</height>
      <texture>user.png</texture>
      <colordiffuse>ffffffff</colordiffuse>
    </control>
	
	<control>
      <description>background overlay</description>
      <type>image</type>
      <id>1090</id>
      <posX>1687</posX>
      <posY>47</posY>
      <width>80</width>
      <height>80</height>
      <texture>prog.png</texture>
	  <animation effect="fade" time="1500" reversible="true">visible</animation>
	  <animation effect="fade" time="1500" reversible="true">hidden</animation>
	  <animation effect="rotate" centre="40,40" delay="0" end="-360" time="2500" loop="true" condition="true">Conditional</animation>
	  <visible>control.isvisible(13)|player.hasmedia|topbar.visible+!control.isvisible(09701)</visible>
      <colordiffuse>ffffffff</colordiffuse>
    </control>
	
    
	
	<control>
      <type>label</type>
      <id>1</id>
      <posX>1680</posX>
      <posY>70</posY>
      <width>200</width>
      <height>30</height>
      <label>#media.user</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
	  <visible>[!control.isvisible(2211)]+string.isset(#media.user)</visible>
    </control>
	
  	<control>
      <type>fadelabel</type>
      <id>2211</id>
      <posX>1680</posX>
      <posY>75</posY>
      <width>1000</width>
      <height>30</height>
      <label>Scraping movies....</label>
      <align>right</align>
      <font>font10</font>
      <textcolor>ffffffff</textcolor>
	  <visible>!string.equals(#MovingPictures.Importer.Status,)+control.isvisible(13)</visible>
    </control>
	
		<control>
		  <description>Date / Time</description>
		  <type>label</type>
		  <id>0</id>
		  <posX>132</posX>
		  <posY>95</posY>
		  <label>#time / #MovingPictures.general.totalmoviecount Movies</label>
		  <align>left</align>
		  <font>font10</font>
		  <textcolor>eaeaea</textcolor>
		  <visible>!player.hasmedia</visible>
		</control>

		
		<control>
		  <description>Current Category</description>
		  <type>label</type>
		  <id>0</id>
		  <posX>132</posX>
		  <posY>48</posY>
		  <align>left</align>
		  <width>1800</width>
		  <font>font18</font>		  
		  <label>350002</label>
		  <textcolor>eaeaea</textcolor>		  
		  <visible>!player.hasmedia</visible>
		</control>		
		
		

		<control>
		  <description>Parental Controls Lock Indicator</description>
		  <type>image</type>
		  <id>16</id>
		  <posX>5</posX>
		  <posY>15</posY>
		  <width>52</width>
		  <height>52</height>
		  <texture>lock.png</texture>
		</control>
		

        <import>movingpictures.overlay.xml</import>
		<!-- Dim background when movie starts -->
		<!-- This is to provide feedback to the user something is happening when there are long pauses before playback -->
		<control>
			<description>Movie Start Indicator</description>
			 <type>image</type>
			 <id>0</id>			 
			 <posX>0</posX>
			 <posY>0</posY>  
			 <width>1920</width>
			 <height>1080</height>
			 <texture>MP_active.png</texture>	
			 <visible>control.isvisible(18)+!control.isvisible(50)+!control.isvisible(51)</visible>
		</control>		

		<control>
			<description>Working Animation</description>
			<type>animation</type>
			<id>13</id>
			<posX>825</posX>
			<posY>120</posY>
			<width>144</width>
			<height>144</height>
			<textures></textures>
			<Duration>0:0:01.5</Duration>
			<keepaspectratio>yes</keepaspectratio>		
		</control>	
		
		<!-- Dummy controls to clean logs of missing controls that don't have those id's any more -->
		
		<control>
        <description>Button</description>
        <id>7</id>
        <type>button</type>
        <visible>false</visible>
      </control>
	  <control>
        <description>Button</description>
        <id>2</id>
        <type>button</type>
        <visible>false</visible>
      </control>
	  <control>
        <description>Button</description>
        <id>5</id>
        <type>button</type>
        <visible>false</visible>
      </control>
	    
	
	</controls>
</window>