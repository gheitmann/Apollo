        <posY>250</posY>
        <layout>StackLayout(0, Vertical, true)</layout>
        <control>
          <id>2</id>
          <description>View-As</description>
          <type>button</type>
          <onright>50</onright>
          <onup>9</onup>
		  <textureFocus>btn_list_blue2.png</textureFocus>
          <textureNoFocus></textureNoFocus>
		  <textYOff>7</textYOff>
		  <width>820</width>
		  <height>50</height>
          <label>100</label>
        </control>
        <control>
          <id>3</id>
          <description>Sort</description>
          <type>sortbutton</type>
          <onright>50</onright>
		  <textureFocus>btn_list_blue2.png</textureFocus>
          <textureNoFocus></textureNoFocus>
		  <textYOff>7</textYOff>
		  <width>820</width>
		  <height>50</height>
        </control>
        <control>
          <id>6</id>
          <description>Views</description>
          <type>button</type>
          <onright>50</onright>
          <label>457</label>
		  <textureFocus>btn_list_blue2.png</textureFocus>
          <textureNoFocus></textureNoFocus>
		  <textYOff>7</textYOff>
		  <width>820</width>
		  <height>50</height>
        </control>
        <control>
          <id>5</id>
          <description>Restart</description>
          <type>button</type>
          <onright>50</onright>
		  <textureFocus>btn_list_blue2.png</textureFocus>
          <textureNoFocus></textureNoFocus>
		  <textYOff>7</textYOff>
		  <width>820</width>
		  <height>50</height>
          <label>#MPEI.Translation.Restart.Label</label>
        </control>
        <control>
          <id>8</id>
          <description>Update all</description>
          <type>button</type>
          <onright>50</onright>
		  <textureFocus>btn_list_blue2.png</textureFocus>
          <textureNoFocus></textureNoFocus>
		  <textYOff>7</textYOff>
		  <width>820</width>
		  <height>50</height>
          <label>#MPEI.Translation.UpdateAll.Label</label>
          <visible>string.contains(#mpei.updates,.::.)</visible>
        </control>
        <control>
          <id>9</id>
          <description>Check for Updates</description>
          <type>button</type>
          <onright>50</onright>
		  <textureFocus>btn_list_blue2.png</textureFocus>
          <textureNoFocus></textureNoFocus>
		  <textYOff>7</textYOff>
		  <width>820</width>
		  <height>50</height>
          <label>#MPEI.Translation.DownloadUpdates.Label</label>
          <ondown>2</ondown>
        </control>
      </control>
