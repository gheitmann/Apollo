<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
  <id>3000</id>
  <defaultcontrol>2</defaultcontrol>
  <controls>

    <!--                                    :: VIDEO OVERLAY ::                                    -->

	
	<control>
      <description>background</description>
      <type>image</type>
      <id>0</id>
      <posX>20</posX>
      <posY>10</posY>
      <width>275</width>
      <height>172</height>
      <texture>tvbac.png</texture>
	  <shouldCache>true</shouldCache>
      <colordiffuse>99000000</colordiffuse>
	  <visible>player.hasmedia+!control.isvisible(3337)</visible>
      <animation effect="fade" time="1500" reversible="true">windowopen</animation>
	  <animation effect="fade" time="100" reversible="true">windowclose</animation>
	  <animation effect="fade" time="1500" reversible="true">visible</animation>
	  <animation effect="fade" time="1500" reversible="true">hidden</animation>
	</control>
	
	    <control>
      <description>video preview window</description>
      <type>videowindow</type>
      <id>99</id>
      <posX>35</posX>
      <posY>28</posY>
      <width>241</width>
      <height>135</height>
      <visible>player.hasmedia+!control.isvisible(3337)</visible>
      <action>18</action>
      <textureFocus>tv_green_border.png</textureFocus>
	  <animation effect="fade" time="1500" reversible="true">windowopen</animation>
	  <animation effect="fade" time="100" reversible="true">windowclose</animation>
	  <animation effect="fade" time="1500" reversible="true">visible</animation>
	  <animation effect="fade" time="0" reversible="true">hidden</animation>
    </control>
	
    <!--     *******************************************************************************************  -->
    <!--     ******************    !!!  THESE CONTROLS ARE FOR COMPATIBILITY ONLY  !!!  ****************  -->
    <!--     *******************************************************************************************  -->
    <control>
      <description>play time label</description>
      <type>label</type>
      <id>2</id>
      <posX>3414</posX>
      <posY>930</posY>
      <label>#currentplaytime</label>
      <align>left</align>
      <font>font12</font>
      <textcolor>80ffffff</textcolor>
    </control>
    <control>
      <description>play logo</description>
      <type>image</type>
      <id>3</id>
      <posX>3414</posX>
      <posY>855</posY>
      <width>78</width>
      <height>77</height>
      <texture>play_enabled.png</texture>
      <visible>!player.paused+!player.forwarding+!player.rewinding</visible>
    </control>
    <control>
      <description>Pause logo</description>
      <type>image</type>
      <id>4</id>
      <posX>3414</posX>
      <posY>855</posY>
      <width>78</width>
      <height>77</height>
      <texture>pause_enabled.png</texture>
      <visible>player.paused</visible>
    </control>
    <control>
      <description>FF logo</description>
      <type>image</type>
      <id>7</id>
      <posX>3414</posX>
      <posY>855</posY>
      <width>78</width>
      <height>77</height>
      <texture>fastforward_enabled.png</texture>
      <visible>player.forwarding</visible>
    </control>
    <control>
      <description>RW logo</description>
      <type>image</type>
      <id>8</id>
      <posX>3414</posX>
      <posY>855</posY>
      <width>78</width>
      <height>77</height>
      <texture>rew_enabled.png</texture>
      <visible>player.rewinding</visible>
    </control>
    <control>
      <description>scrolling info label Video</description>
      <type>fadelabel</type>
      <id>5</id>
      <posX>64</posX>
      <posY>4020</posY>
      <width>457</width>
      <height>55</height>
      <font>font12</font>
      <label>#Play.Current.Title\r#Play.Current.Genre\r#Play.Current.Year\r#Play.Current.Director</label>
      <textcolor>EFFFFFFF</textcolor>
    </control>
  </controls>
</window>
